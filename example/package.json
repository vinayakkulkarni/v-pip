{
  "name": "@vinayakkulkarni/v-pip-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Live demo of v-pip on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --config .output/server/wrangler.json",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "catalog:",
    "nuxt": "catalog:",
    "v-pip": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  }
}
